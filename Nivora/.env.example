# Copia este archivo como .env (en la carpeta Nivora) y completa los valores.
# Nunca subas el archivo .env al repositorio.

# --- Correo (recuperación y cambio de contraseña) ---
# Gmail: activa la verificación en dos pasos y crea una "contraseña de
# aplicación" en https://myaccount.google.com/apppasswords
NIVORA_SMTP_HOST=smtp.gmail.com
NIVORA_SMTP_PORT=587
NIVORA_SMTP_USERNAME=tu-correo@gmail.com
NIVORA_SMTP_PASSWORD=pega-aqui-la-contrasena-de-aplicacion
NIVORA_SMTP_FROM=Nivora <tu-correo@gmail.com>
# 587 usa STARTTLS (NIVORA_SMTP_USE_TLS=1). Para el puerto 465 se usa SSL
# automáticamente; también puedes forzarlo con NIVORA_SMTP_USE_SSL=1.
NIVORA_SMTP_USE_TLS=1
NIVORA_SMTP_USE_SSL=0
NIVORA_PASSWORD_RESET_TTL=3600

# --- Aplicación ---
NIVORA_SECRET_KEY=clave-local-de-desarrollo
NIVORA_DATABASE_PATH=
NIVORA_COOKIE_SECURE=0
NIVORA_HOST=127.0.0.1
# Dirección pública usada en los enlaces de los correos. Déjala vacía en
# Codespaces o en local: Nivora usa el dominio desde el que se accede.
# Configúrala en producción, p. ej. https://TU-APP.azurewebsites.net
NIVORA_PUBLIC_URL=
